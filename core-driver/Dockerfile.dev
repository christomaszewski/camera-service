# Software development image: GStreamer 1.28.7 on Ubuntu 26.04 (no NVIDIA stack).
# Default: docker build -f core-driver/Dockerfile.dev -t cam-dev:dev .
# Distro compatibility: add --target distro --build-arg BASE=ubuntu:22.04 (or 24.04).
ARG BASE=ubuntu:26.04
FROM ubuntu:26.04 AS gstreamer
COPY tools/gstreamer/build.sh tools/gstreamer/SHA256SUMS /build-gstreamer/
RUN bash /build-gstreamer/build.sh

FROM ${BASE} AS distro
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-gi python3-yaml python3-numpy python3-pip \
      gir1.2-glib-2.0 gir1.2-gstreamer-1.0 gir1.2-gst-plugins-base-1.0 gir1.2-aravis-0.8 \
      gir1.2-gst-rtsp-server-1.0 \
      gstreamer1.0-tools gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
      gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly gstreamer1.0-libav \
      aravis-tools \
    && rm -rf /var/lib/apt/lists/*
# eclipse-zenoh: the Python Zenoh binding for the lifecycle control plane (docs/LIFECYCLE.md). A prebuilt
# manylinux abi3 wheel on arm64/x86 -- no Rust build. One pin across the core and the webrtc-bridge.
# PIP_BREAK_SYSTEM_PACKAGES: the 24.04 base is PEP 668 externally-managed; 22.04's pip ignores the var.
ENV PIP_BREAK_SYSTEM_PACKAGES=1
RUN pip3 install --no-cache-dir eclipse-zenoh==1.9.0

WORKDIR /app
COPY core-driver/ /app/
ENV CAM_CONFIG=/app/config/fake-camera.yaml

# Default: fake-camera capture -> timestamps -> FFV1 recording -> transport.
CMD ["python3", "main.py", "-c", "config/fake-camera.yaml", "-v"]

# Default target; distro above remains available for older runtime regression tests.
FROM distro AS modern
# The overlay is compiled against 26.04. Fail instead of loading it into an older userspace.
RUN . /etc/os-release && test "$ID:$VERSION_ID" = ubuntu:26.04 \
    && apt-get update && apt-get install -y --no-install-recommends --no-upgrade libunwind8 libdw1t64 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=gstreamer /opt/gstreamer /opt/gstreamer
ENV PATH=/opt/gstreamer/bin:$PATH \
    LD_LIBRARY_PATH=/opt/gstreamer/lib:/usr/local/lib:/usr/local/lib/aarch64-linux-gnu:/usr/local/lib/x86_64-linux-gnu \
    GI_TYPELIB_PATH=/opt/gstreamer/lib/girepository-1.0 \
    GST_PLUGIN_PATH=/opt/gstreamer/lib/gstreamer-1.0:/usr/local/lib/gstreamer-1.0 \
    GST_PLUGIN_SYSTEM_PATH=/usr/lib/aarch64-linux-gnu/gstreamer-1.0:/usr/lib/x86_64-linux-gnu/gstreamer-1.0 \
    PKG_CONFIG_PATH=/opt/gstreamer/lib/pkgconfig
COPY tools/gstreamer/check.py /opt/gstreamer/check.py
RUN python3 /opt/gstreamer/check.py
